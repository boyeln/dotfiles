export EDITOR="/opt/homebrew/bin/hx";
export XDG_CONFIG_HOME="$HOME/.config"

# Add deno completions to search path
if [[ ":$FPATH:" != *":/Users/bln/.zsh/completions:"* ]]; then export FPATH="/Users/bln/.zsh/completions:$FPATH"; fi
export ZSH="$HOME/.oh-my-zsh"

# ZSH_THEME=""
plugins=(git zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# Pure prompt
# fpath+=($HOME/.zsh/pure)
# autoload -U promptinit; promptinit
# prompt pure
# PURE_PROMPT_SYMBOL="$"

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# . "$HOME/.local/bin/env"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc' ]; then . '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc' ]; then . '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc'; fi
. "/Users/bln/.deno/env"
# Initialize zsh completions (added by deno install script)
fpath+=~/.zfunc
autoload -Uz compinit
compinit
# opencode
export PATH=/Users/bln/.opencode/bin:$PATH

# bun completions
[ -s "/Users/bln/.bun/_bun" ] && source "/Users/bln/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# fly.io
export FLYCTL_INSTALL="$HOME/.fly"
export PATH="$FLYCTL_INSTALL/bin:$PATH"

# claude ask
ask() {
  claude \
    --model haiku \
    --allowed-tools WebSearch,WebFetch,Task,TodoWrite,Skill \
    --system-prompt "Be extremly concise. Sacrifice grammer for concision. No code unless requested." \
    "$@"
}

# claude with separate config
alias cc="claude --allow-dangerously-skip-permissions"
alias ccp="CLAUDE_CONFIG_DIR=/Users/bln/.claude-personal claude --allow-dangerously-skip-permissions"

eval "$(zellij setup --generate-auto-start zsh)"

eval "$(starship init zsh)"

# fnm
FNM_PATH="/opt/homebrew/opt/fnm/bin"
if [ -d "$FNM_PATH" ]; then
  eval "`fnm env`"
fi

export PATH="/opt/homebrew/opt/llvm/bin:$PATH"

# asdf shims
export PATH="$HOME/.asdf/shims:$PATH"
